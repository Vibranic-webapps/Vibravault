# Neon Postgres — create a project at https://console.neon.tech
# Use the POOLED connection string for the app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (UNPOOLED) connection — required by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend (password reset email). Without it, reset links are logged to the
# server console instead of sent - the flow still works locally.
RESEND_API_KEY=""
MAIL_FROM="Vibravault <noreply@kilianfrederix.net>"
NUXT_PUBLIC_SITE_URL="https://vibravault.kilianfrederix.net"

# Vibradex diagnostics hub. Unset = telemetry silently does nothing.
VIBRADEX_URL="https://vibradex.kilianfrederix.net"
VIBRADEX_API_KEY=""

# Shared demo account(s), comma-separated, case-insensitive: they can use the app
# but not change password/name or reset. Unset = "demo@kilianfrederix.net"; "" = none.
# Signup is refused for these too. NEVER set "" on production (it would open signup for the
# demo address to anyone): (re)create or repair the demo user with a one-off script instead.
DEMO_EMAILS="demo@kilianfrederix.net"
