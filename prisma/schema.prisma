// Vibravault — Prisma schema
//
// Design decisions live in the vault:
//   KF OS/03 Projects/vibravault/02 Data Model/(C) v1 Schema Design.md
//   KF OS/03 Projects/vibravault/02 Data Model/(C) Bank CSV Format - KBC.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountType {
  BANK
  VOUCHER // maaltijdcheques / ecocheques
  CASH
  SAVINGS
}

enum CategoryKind {
  INCOME
  EXPENSE
  // Money moving between the user's OWN accounts (e.g. KBC <-> Revolut).
  // Still moves the balance of the account it touches, but is neither income
  // nor spending, so it is excluded from In / Out / Net and the charts.
  // Project rule #4, and found inflating real totals on 2026-09-26.
  TRANSFER
}

// How often a recurring item comes due (see RecurringItem).
enum RecurringCadence {
  WEEKLY
  BIWEEKLY // every 2 weeks
  MONTHLY
  QUARTERLY // every 3 months
  YEARLY
}

// Money out (a bill) or money in (pay). Keeps the SIGN out of the min/max amounts.
enum RecurringDirection {
  IN
  OUT
}

// A manual override for ONE due date of a recurring item.
enum RecurringSettlementKind {
  SKIPPED // "skip this time": nothing is expected for that date
  MARKED_PAID // "mark paid" / "received": settled by hand, no bank row needed
}

enum TransactionSource {
  MANUAL
  CSV
  PSD2 // not in v1 — the enum value costs nothing now
}

// ---------------------------------------------------------------------------
// Auth (ported from VibraFlow)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String? // what the app calls you ("Hey Kilian"); optional
  passwordHash String
  createdAt    DateTime @default(now())

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  importTokens          ImportToken[]
  merchantRules         MerchantRule[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  importBatches         ImportBatch[]
  pendingTransactions   PendingTransaction[]
  discardedFingerprints DiscardedFingerprint[]
  goals                 Goal[]
  goalContributions     GoalContribution[]
  recurringItems        RecurringItem[]
  recurringSettlements  RecurringSettlement[]
  recurringSuggestionDismissals RecurringSuggestionDismissal[]
}

model Session {
  id String @id @default(cuid())

  // The cookie carries 32 random bytes; the DB only ever stores their SHA-256
  // hash. A leaked database therefore yields no usable session cookies.
  // Plain SHA-256 is enough: the token is already high-entropy random, so it
  // does not need the slow salted hashing that human passwords require.
  hashedToken String @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // no default — computed at login (now + 30 days)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Same design as Session: the emailed link carries 32 random bytes, the DB only
// ever holds their SHA-256 hash. A leaked database yields no usable reset links.
model PasswordResetToken {
  id          String    @id @default(cuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime // short-lived: 1 hour
  usedAt      DateTime? // single use - a link works exactly once
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// A long-lived credential for the iOS Shortcut that shares a CSV into the app.
// Same hashing discipline as Session and PasswordResetToken: the Shortcut holds
// the raw token, the DB only ever holds its SHA-256 hash, so a database leak
// yields nothing that can import into an account.
//
// Deliberately SEPARATE from the password: it can be revoked on its own if a
// phone is lost, without forcing a password change or logging out everywhere.
model ImportToken {
  id          String    @id @default(cuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // e.g. "iPhone Shortcut" - so multiple devices stay tellable apart
  lastUsedAt  DateTime? // shows at a glance whether it is still in use
  revokedAt   DateTime? // revoked, not deleted: the audit trail survives
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// A rule the user taught the app: "anything whose description contains X is
// called Y and filed under Z". Layer 1 of labelling - an explicit user decision
// beats every automatic guess, the bank's name field included.
//
// `match` is plain text, matched by ruleMatches() as a case- and spacing-
// insensitive "contains". Never a regex: a typed regex is a ReDoS hole.
//
// The label is applied at RENDER time (never stored on transactions), so
// editing or deleting a rule instantly changes every affected row. The category
// is WRITTEN, because categories drive totals - but only onto rows that are
// still uncategorised, so a choice made by hand is never overwritten.
model MerchantRule {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match          String
  label          String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Optional amount condition, in cents, compared on the ABSOLUTE value of the
  // transaction (a 0.99 charge is stored as -99; the rule says 99). Both null =
  // any amount (every rule created before this existed). An exact amount X is
  // min = max = X; a range is min < max, both ends inclusive. Either both are
  // set or neither - enforced at the API (validateRuleAmount), not in the DB.
  amountMinCents Int?
  amountMaxCents Int?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

// Exists in v1, INVISIBLE in v1: one seeded row, no management UI.
// Deliberately NO balance column — balance is derived from transactions, so
// there is only ever one source of truth.
model Account {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType @default(BANK)
  currency  String      @default("EUR")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions        Transaction[]
  pendingTransactions PendingTransaction[]
  recurringItems      RecurringItem[]

  @@index([userId])
}

// color = a token from the curated 12-tint set. Category colour is IDENTITY and
// lives only in the icon tile; it must never collide with teal (income) or
// coral (expense), which carry SEMANTICS.
model Category {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  kind           CategoryKind
  icon           String
  color          String
  // Optional monthly spending limit in integer cents, EXPENSE categories only.
  // One limit that repeats every month until changed (no per-month rows).
  // Positive when set - CHECK constraint hand-added in the migration.
  budgetCents    Int?
  // Marks a recurring-bill category (Netflix, phone plan...). EXPENSE only, which
  // the API enforces. Drives the "subscriptions" ring + list in Transactions
  // insights; a flag on the category so a new one needs no code change.
  isSubscription Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions        Transaction[]
  merchantRules       MerchantRule[]
  pendingTransactions PendingTransaction[]
  recurringItems      RecurringItem[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Nullable: imported rows arrive uncategorised, and that is a normal state.
  // SetNull on delete — deleting a category must never delete financial history.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // SIGNED integer cents. Negative = expense. Matches KBC's `Bedrag` exactly,
  // so imports need no sign transformation and can't invert one.
  amountCents Int

  bookedAt         DateTime // KBC `Datum` (booking date, never `Valuta`)
  counterparty     String? // KBC `Naam tegenpartij`
  counterpartyIban String? // KBC `Rekening tegenpartij` — best key for future auto-categorisation
  description      String? // KBC `Omschrijving` + `vrije mededeling`

  // KBC `Saldo` — balance after this transaction. Two jobs: disambiguates
  // identical same-day rows in the fingerprint, and gives the importer a free
  // integrity check against the bank's own running balance.
  balanceAfterCents Int?

  source TransactionSource @default(MANUAL)

  // Dedupe key. NO @@unique here on purpose: deleted rows must not block a
  // re-import, so this needs a PARTIAL unique index (WHERE deleted_at IS NULL),
  // which Prisma's DSL cannot express. Added by hand in the migration SQL.
  fingerprint String

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  deletedAt DateTime? // soft delete — filter centrally, never per call site
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, bookedAt])
  @@index([userId, fingerprint])
  @@index([accountId])
  @@index([categoryId])
}

// One row per CSV upload. Earns its place twice over: lets you undo a bad
// import as a unit, and lets the UI say "42 rows, 9 new, 33 already there" —
// which is what makes an importer feel trustworthy instead of scary.
model ImportBatch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  importedAt   DateTime @default(now())
  rowsParsed   Int      @default(0)
  rowsInserted Int      @default(0)
  rowsSkipped  Int      @default(0)

  transactions Transaction[]

  @@index([userId])
}

// ---- Review before import (decided 2026-09-27) ------------------------------
// Rows shared through the iOS Shortcut WAIT here until Kilian reviews them in
// the app. A separate table on purpose: every total, the balance and every
// list read Transaction only, so a waiting row can never count by accident.
model PendingTransaction {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amountCents       Int // signed, like Transaction
  bookedAt          DateTime // same type as Transaction.bookedAt
  counterparty      String?
  counterpartyIban  String?
  description       String?
  balanceAfterCents Int?
  fingerprint       String // same fingerprintRow() as Transaction
  // Suggested by a taught rule when the row arrived; kept on "Add these".
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  filename          String?
  createdAt         DateTime  @default(now())

  // Sharing the same file twice before reviewing must not double anything.
  @@unique([userId, fingerprint])
  @@index([userId])
}

// "Removed in review" - remembered so later overlapping imports don't offer
// the same bank transaction again. Only the fingerprint: nothing else about a
// row you said no to is kept.
model DiscardedFingerprint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([userId, fingerprint])
}

// ---- Savings goals (decided 2026-11-09) --------------------------------------
// A goal is a target you save towards with MANUAL contributions. Deliberately
// NOT linked to Transaction: moving money into savings is a transfer, neither
// income nor expense (project rule #4), so goals must never touch the flow
// totals. There is NO savedCents column: the saved amount is always the SUM of
// the contributions, so it can never drift out of sync.
model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetCents Int // positive integer cents (CHECK > 0 added by hand in the migration)
  dueDate     DateTime? // optional; a calendar day stored as UTC midnight
  // Optional look of the goal. All nullable: existing goals keep working unchanged.
  imageData   Bytes? // the shrunk picture (browser downsizes to a small JPEG; API caps at 150 KB). Never sent inside JSON.
  imageMime   String? // 'image/jpeg' | 'image/webp' | 'image/png'; set exactly when imageData is (CHECK added by hand)
  imageUrl    String? // a pasted https link; at most one of imageData / imageUrl is set (enforced in the API)
  tint        String? // pastel name: 'mint' | 'blush' | 'sky' | 'lavender' | 'butter' (validated in the API, so a new colour needs no migration)
  // How the picture is framed inside the card (applied in CSS, never baked into the bytes). Ranges CHECKed by hand in the migration.
  imageFocusX Int       @default(50) // focus point, % from the left, 0..100
  imageFocusY Int       @default(50) // focus point, % from the top, 0..100
  imageZoom   Int       @default(100) // percent, 100 = no zoom .. 300 = 3x
  deletedAt   DateTime? // soft delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amountCents   Int // SIGNED: + saved, - taken out (CHECK <> 0 added by hand in the migration)
  contributedAt DateTime
  note          String?
  createdAt     DateTime @default(now())

  @@index([goalId, contributedAt])
  @@index([userId])
}

// ---- Recurring payments + bills (decided 2026-11-16) -------------------------
// A RecurringItem is the RULE ("Netflix, 13.99, monthly on the 14th"). A bill is
// one due occurrence of it. Nothing about an occurrence is stored: due dates are
// computed from anchorOn + cadence (shared/utils/recurring.ts) and "paid" is
// derived by matching bank rows. Only a manual override is stored.
model RecurringItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String // what you see ("Netflix"), max 40 chars (API)
  match String // bank text to find it: same "contains" semantics as MerchantRule (min 3 chars, never regex)

  // Cents on the ABSOLUTE value, like MerchantRule (a 0.99 charge = 99). A fixed
  // bill has min = max. CHECK constraints (both > 0, min <= max) hand-added in the migration.
  amountMinCents Int
  amountMaxCents Int
  direction      RecurringDirection
  cadence        RecurringCadence

  // A known due date (date-only). Every other due date is computed FROM it each
  // time (never from the previous one), so month-end clamping cannot drift.
  // No due date is generated before the anchor.
  anchorOn DateTime @db.Date

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId  String? // which account it is paid from (hidden in the UI until 2+ accounts)
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  active    Boolean  @default(true) // pause without deleting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlements RecurringSettlement[]

  @@index([userId])
}

model RecurringSettlement {
  id              String                  @id @default(cuid())
  userId          String // redundant with the item's owner on purpose: every query can be scoped by userId directly
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringItemId String
  item            RecurringItem           @relation(fields: [recurringItemId], references: [id], onDelete: Cascade)
  dueOn           DateTime                @db.Date
  kind            RecurringSettlementKind
  createdAt       DateTime                @default(now())

  @@unique([recurringItemId, dueOn])
  @@index([userId])
}

// "Not now" on a suggested recurring item (phase 1b): the suggestion stays hidden
// for 30 days, then may come back. `key` = direction|merchant|typicalAmountCents
// (built by shared/utils/recurringSuggestions.ts). Nothing else is stored about a
// suggestion: they are derived from bank history on every request.
model RecurringSuggestionDismissal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  dismissedAt DateTime // set again on every "Not now", so the 30 days restart

  @@unique([userId, key])
}
